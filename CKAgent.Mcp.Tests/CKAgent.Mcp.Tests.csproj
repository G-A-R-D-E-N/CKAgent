<Project Sdk="Microsoft.NET.Sdk">

  <!-- Constraint: xunit v3 is an executable, and the SDK 10 native Microsoft.Testing.Platform mode of
       dotnet test is selected in global.json, so the suite runs without a VSTest testhost. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v1" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CKAgent.Mcp\CKAgent.Mcp.csproj" />
  </ItemGroup>

</Project>
